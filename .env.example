# ============================================================
#  本地环境变量模板（复制为 .env 后填写真实值）
#  .env 已被 .gitignore 忽略，不会进入版本库
#  用法：Copy-Item .env.example .env  然后编辑 .env
# ============================================================

# ---------- 被测接口（跑真实接口回归时必填）----------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填你的密钥
LLM_MODEL=deepseek-chat

# ---------- 禅道（上传运行信息 / 自动提单时必填）----------
# 置为 1 才启用禅道相关功能
ZENTAO_ENABLED=1
ZENTAO_BASE_URL=http://127.0.0.1:81/zentao
ZENTAO_PRODUCT_ID=1
ZENTAO_BUILD=trunk

# 两种鉴权方式二选一：
# 1) 账号密码（脚本会自动换取 token）
ZENTAO_ACCOUNT=admin
ZENTAO_PASSWORD=在这里填你的密码
# 2) 直接用 token（优先于账号密码）
# ZENTAO_TOKEN=

# 缺陷单默认严重程度 / 优先级
ZENTAO_SEVERITY=3
ZENTAO_PRI=3
